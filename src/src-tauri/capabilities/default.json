{
  "identifier": "main",
  "description": "Studio windows: main editor, project windows, detached piano roll and mixer",
  "windows": [
    "main",
    "piano-roll",
    "mixer",
    "project-2",
    "project-3",
    "project-4",
    "project-5",
    "project-6",
    "project-7",
