{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenosStyleStudio",
  "version": "0.1.0",
  "identifier": "com.genosstylestudio.desktop",
  "build": {
    "beforeDevCommand": "npm run notices && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run notices",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GenosStyleStudio",
        "width": 1480,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#151719"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Yamaha Style and MIDI editor",
    "category": "Music",
    "resources": { "../../docs/development/third-party/": "third-party/" }
  }
}
